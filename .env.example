# Docker Compose PostgreSQL
POSTGRES_DB=character_chat
POSTGRES_USER=character_chat
POSTGRES_PASSWORD=character_chat
POSTGRES_PORT=5433

# Spring Boot
DB_URL=jdbc:postgresql://localhost:5433/character_chat
DB_USERNAME=character_chat
DB_PASSWORD=character_chat
APP_PORT=8081
BOOK_INPUT_ROOT=../test-books

# AI
# 실제 분석과 대화를 실행할 때 openai로 변경하고 개인 API 키를 입력합니다.
AI_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_TIMEOUT=60s
OPENAI_MAX_RETRIES=2
AI_ENTITY_BATCH_SIZE=20

# RAG
RAG_TOP_K=3
RAG_CONTEXT_WINDOW=2
RAG_EMBEDDING_BATCH_SIZE=100

# Next.js
BACKEND_URL=http://localhost:8081

# Gradio QA
QA_SERVER_NAME=127.0.0.1
QA_SERVER_PORT=7860
QA_REQUEST_TIMEOUT_SECONDS=900
